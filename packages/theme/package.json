{
  "name": "@anglefeint/astro-theme",
  "version": "0.36.1",
  "type": "module",
  "description": "Anglefeint core theme package for Astro",
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "portfolio",
    "cyberpunk",
    "hacker",
    "matrix"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "tsconfig.json",
    "src/index.ts",
    "src/content-schema.ts",
    "src/config",
    "src/components",
    "src/covers",
    "src/effects",
    "src/layouts",
    "src/scaffold",
    "src/scripts",
    "src/i18n",
    "src/styles",
    "src/utils",
    "src/assets/theme",
    "src/cli-new-post.mjs",
    "src/cli-new-page.mjs",
    "src/search.mjs",
    "src/search.d.mts",
    "src/machine-readable.mjs",
    "src/machine-readable.d.mts",
    "src/machine",
    "src/social-image.mjs",
    "src/social-image.d.mts",
    "src/social",
    "src/markdown.mjs",
    "src/markdown.d.mts",
    "src/integration.mjs",
    "src/integration.d.mts",
    "src/project",
    "src/routes",
    "src/sitemap.mjs",
    "src/cli.mjs",
    "src/scaffold/upgrade.mjs"
  ],
  "bin": {
    "anglefeint-new-post": "src/cli-new-post.mjs",
    "anglefeint-new-page": "src/cli-new-page.mjs",
    "anglefeint": "src/cli.mjs",
    "astro-theme": "src/cli.mjs"
  },
  "exports": {
    "./tsconfig": "./tsconfig.json",
    ".": "./src/index.ts",
    "./components/*": "./src/components/*",
    "./effects/*": "./src/effects/*",
    "./layouts/*": "./src/layouts/*",
    "./scripts/*": "./src/scripts/*",
    "./i18n/*": "./src/i18n/*",
    "./styles/*": "./src/styles/*",
    "./assets/*": "./src/assets/*",
    "./utils/about-sections": "./src/utils/about-sections.ts",
    "./utils/merge": "./src/utils/merge.ts",
    "./utils/project-config": "./src/scaffold/project-config.mjs",
    "./utils/number": "./src/utils/number.ts",
    "./utils/metrics": "./src/utils/metrics.ts",
    "./utils/tags": "./src/utils/tags.ts",
    "./utils/terminal-document": "./src/utils/terminal-document.ts",
    "./utils/music": "./src/utils/music.ts",
    "./utils/comments": "./src/utils/comments.ts",
    "./utils/pagination": "./src/utils/pagination.ts",
    "./utils/pagination-style": "./src/utils/pagination-style.ts",
    "./utils/*": "./src/utils/*",
    "./content-schema": "./src/content-schema.ts",
    "./social-image": {
      "types": "./src/social-image.d.mts",
      "default": "./src/social-image.mjs"
    },
    "./search": {
      "types": "./src/search.d.mts",
      "default": "./src/search.mjs"
    },
    "./machine-readable": {
      "types": "./src/machine-readable.d.mts",
      "default": "./src/machine-readable.mjs"
    },
    "./markdown": {
      "types": "./src/markdown.d.mts",
      "default": "./src/markdown.mjs"
    },
    "./integration": {
      "types": "./src/integration.d.mts",
      "default": "./src/integration.mjs"
    },
    "./config": "./src/project/index.ts",
    "./env": "./src/project/env.d.ts",
    "./runtime/*": "./src/project/*",
    "./sitemap": "./src/sitemap.mjs",
    "./utils/fragments": "./src/utils/fragments.ts"
  },
  "peerDependencies": {
    "astro": "^7.3.5"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "jiti": "^2.7.0",
    "js-yaml": "^4.3.2",
    "katex": "^0.19.0",
    "mdast-util-from-markdown": "^2.1.0",
    "nanoid": "^5.1.16",
    "node-html-parser": "^9.0.6",
    "pagefind": "^1.5.2",
    "satori": "0.33.5",
    "satteri": "^0.10.5",
    "semver": "^7.7.3",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vite": "^8.3.5"
  },
  "anglefeint": {
    "projectSchema": 1
  }
}
