---
import type { MarkdownHeading } from 'astro';
import { buildArticleToc } from '../utils/article-toc';

interface Props {
  headings?: MarkdownHeading[];
  enabled?: boolean;
  label: string;
}

const { headings = [], enabled = true, label } = Astro.props;
const entries = enabled ? buildArticleToc(headings) : [];
---

{
  entries.length > 0 && (
    <div class="ai-toc-rail">
      <details class="ai-article-toc" open>
        <summary>{label}</summary>
        <nav aria-label={label}>
          <ul>
            {entries.map((entry) => (
              <li>
                <a href={`#${encodeURIComponent(entry.slug)}`}>{entry.text}</a>
                {entry.children.length > 0 && (
                  <ul>
                    {entry.children.map((child) => (
                      <li>
                        <a href={`#${encodeURIComponent(child.slug)}`}>{child.text}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  )
}

<style>
  .ai-article-toc {
    margin: 1.5rem 0;
    border: 1px solid rgba(126, 192, 224, 0.28);
    border-radius: 0.65rem;
    background: rgba(10, 20, 30, 0.55);
    color: #c4d8e6;
    font-size: 0.95rem;
    line-height: 1.6;
    min-width: 0;
  }
  summary {
    padding: 0.8rem 1rem;
    color: #d4ecfa;
    cursor: pointer;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  summary::marker {
    color: #8ec9e9;
  }
  nav {
    padding: 0 1rem 0.8rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  ul ul {
    padding-left: 1rem;
    margin-left: 0.25rem;
    border-left: 1px solid rgba(126, 192, 224, 0.22);
  }
  li {
    margin: 0;
  }
  a {
    display: block;
    padding: 0.3rem 0.4rem;
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
    border-radius: 0.25rem;
  }
  a:hover {
    color: #fff;
    background: rgba(126, 192, 224, 0.1);
  }
  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid #8ec9e9;
    outline-offset: 2px;
  }
  :global(.ai-prose-body :is(h2, h3)[id]) {
    scroll-margin-top: 7rem;
  }
  /* Keep the centered reading column intact; use its gutter only when it fits. */
  @media (min-width: 1360px) {
    .ai-toc-rail {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(100% + 1.2rem);
      width: 14rem;
    }
    .ai-article-toc {
      position: sticky;
      top: 6rem;
      margin: 0;
      font-size: 0.875rem;
      background: rgba(10, 20, 30, 0.94);
      max-height: calc(100dvh - 10rem - clamp(1rem, 8vh, 4rem));
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
    .ai-article-toc nav a {
      color: #c4d8e6;
      text-decoration: none;
      text-shadow: none;
      animation: none;
    }
    .ai-article-toc nav a:hover {
      color: #fff;
    }
    :global(body:has(.ai-toc-rail) .ai-back-to-top) {
      left: auto;
      right: 3rem;
      top: auto;
      bottom: clamp(1rem, 8vh, 4rem);
      transform: none;
    }
  }
</style>
