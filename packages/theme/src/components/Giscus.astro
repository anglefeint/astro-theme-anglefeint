---
import { giscusConfig, type GiscusComments } from '../utils/comments';
type Props = { comments: GiscusComments; resolvedLocale: string; deferred?: boolean };
const { comments, resolvedLocale, deferred = false } = Astro.props;
const config = giscusConfig(comments, resolvedLocale, deferred);
const payload = JSON.stringify(config).replace(/</g, '\\u003c');
const attributes = {
  'data-repo': config.repo,
  'data-repo-id': config.repoId,
  'data-category': config.category,
  'data-category-id': config.categoryId,
  'data-mapping': config.mapping,
  'data-term': config.term,
  'data-number': config.number,
  'data-strict': config.strict,
  'data-reactions-enabled': config.reactionsEnabled,
  'data-emit-metadata': config.emitMetadata,
  'data-input-position': config.inputPosition,
  'data-theme': config.theme,
  'data-lang': config.lang,
  'data-loading': config.loading,
  crossorigin: config.crossorigin,
};
---

{
  deferred ? (
    <>
      <script type="application/json" data-fragment-config set:html={payload} />
      <template data-giscus-template>
        <script is:inline src="https://giscus.app/client.js" {...attributes} async />
      </template>
    </>
  ) : (
    <script is:inline src="https://giscus.app/client.js" {...attributes} async />
  )
}
