---
import type { Messages } from '../../i18n/messages';
import NetworkBackdrop from '../shared/NetworkBackdrop.astro';
import DecoderForm from './DecoderForm.astro';
import '../../styles/decoder.css';
interface Props {
  labels: Messages['decoder'];
  pageLabels: Messages['decoderPage'];
  full?: boolean;
}
const { full = false } = Astro.props;
---

{full && <NetworkBackdrop />}
<DecoderForm {...Astro.props} />
