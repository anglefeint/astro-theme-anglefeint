---
import '../../styles/back-to-top.css';

interface Props {
  label: string;
  layout?: 'article' | 'feed';
}
const { label, layout = 'article' } = Astro.props;
---

<button
  type="button"
  class="ai-back-to-top"
  data-back-to-top
  data-back-to-top-layout={layout}
  aria-label={label}
  title={label}
  aria-hidden="true"
  tabindex="-1">↑</button
>

<script>
  import { initBackToTop } from '../../scripts/back-to-top.js';
  initBackToTop();
  document.addEventListener('astro:page-load', initBackToTop);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) initBackToTop();
  });
</script>
