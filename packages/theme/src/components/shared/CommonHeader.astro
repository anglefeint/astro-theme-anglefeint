---
import { SITE_TITLE } from '@anglefeint/site-config/site';
import { SOCIAL_LINKS } from '@anglefeint/site-config/social';
import { THEME } from '@anglefeint/site-config/theme';
import HeaderLink from '../HeaderLink.astro';
import LangSwitcher from './LangSwitcher.astro';
import SocialMenu from './SocialMenu.astro';
import Search from '../Search.astro';
import {
  DEFAULT_LOCALE,
  ENABLED_LOCALE_LABELS,
  type Locale,
  ENABLED_LOCALES,
  alternatePathForLocale,
  isLocale,
  stripLocaleFromPath,
} from '@anglefeint/site-i18n/config';

interface Props {
  locale?: Locale;
  homeHref?: string;
  /** Optional per-locale overrides (used for existence-aware language fallback on some routes). */
  localeHrefs?: Partial<Record<Locale, string>>;
  /** Show Blade Runner scanlines overlay on ai-page (header/footer only) */
  scanlines?: boolean;
  labels?: {
    home: string;
    blog: string;
    about: string;
    status: string;
    statusAria: string;
    language: string;
  };
}

const props = Astro.props as Props;
const locale: Locale = props.locale && isLocale(props.locale) ? props.locale : DEFAULT_LOCALE;
const labels = {
  home: props.labels?.home ?? 'Home',
  blog: props.labels?.blog ?? 'Blog',
  about: props.labels?.about ?? 'About',
  status: props.labels?.status ?? 'system: online',
  statusAria: props.labels?.statusAria ?? 'System status',
  language: props.labels?.language ?? 'Language',
};
const showAbout = THEME.ABOUT_PAGE_ENABLED;
const showDecoder = THEME.DECODER_PAGE_ENABLED ?? true;
const currentSubpath = stripLocaleFromPath(Astro.url.pathname, locale);
const homeHref = props.homeHref ?? alternatePathForLocale(locale, '/');
const buildLocaleHref = (targetLocale: Locale) => {
  // Language switcher: preserve current route when switching locales.
  // Only fall back for About when the feature is disabled.
  const sectionSubpath =
    currentSubpath.startsWith('/about') && !showAbout ? '/' : currentSubpath || '/';
  return alternatePathForLocale(targetLocale, sectionSubpath);
};
const localeOptions = ENABLED_LOCALES.map((targetLocale) => ({
  locale: targetLocale,
  label: ENABLED_LOCALE_LABELS[targetLocale],
  href: props.localeHrefs?.[targetLocale] ?? buildLocaleHref(targetLocale),
}));
---

<header>
  <nav>
    <div class="nav-left">
      <h2><a href={homeHref}>{SITE_TITLE}</a></h2>
    </div>
    <div class="internal-links">
      <HeaderLink href={homeHref}>{labels.home}</HeaderLink>
      <HeaderLink data-home-passage href={alternatePathForLocale(locale, '/blog/')}
        >{labels.blog}</HeaderLink
      >
      {
        showAbout && (
          <HeaderLink href={alternatePathForLocale(locale, '/about/')}>{labels.about}</HeaderLink>
        )
      }
      {
        showDecoder && (
          <details class="frontier-dropdown">
            <summary aria-label="Frontier" title="Frontier">
              <svg width="14" height="14" viewBox="0 0 8 8" aria-hidden="true">
                <path d="M0 2h8L4 6Z" fill="currentColor" />
              </svg>
            </summary>
            <div class="frontier-dropdown-links">
              <div class="frontier-title">Frontier</div>
              <HeaderLink href={alternatePathForLocale(locale, '/decoder/')}>
                Decoder Lab
              </HeaderLink>
            </div>
          </details>
        )
      }
    </div>
    <div class="nav-right">
      <div class="social-links">
        {(THEME.SEARCH?.ENABLED ?? true) && <Search locale={locale} />}
        <LangSwitcher label={labels.language} currentLocale={locale} options={localeOptions} />
        <div class="nav-status" aria-label={labels.statusAria}>
          <span class="nav-status-dot" aria-hidden="true"></span>
          <span class="nav-status-text">{labels.status}</span>
        </div>
        <div class="social-menu-wrap">
          <SocialMenu links={SOCIAL_LINKS} tone="header" gap="0.6rem" />
        </div>
      </div>
    </div>
  </nav>
  {props.scanlines && <div class="ai-scanlines" aria-hidden="true" />}
</header>
<script>
  document.addEventListener('pointerdown', (event) => {
    if (!(event.target instanceof Node)) return;
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('.frontier-dropdown[open]')) {
      if (!menu.contains(event.target)) menu.open = false;
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('.frontier-dropdown[open]')) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
<style>
  .frontier-dropdown {
    position: relative;
    align-self: stretch;
    margin-left: 0.65rem;
  }
  .frontier-title {
    position: relative;
    padding: 0.65rem 0.8rem 0.5rem;
    margin-bottom: 0.2rem;
    border-bottom: 1px solid var(--chrome-border, rgb(var(--border)));
    color: #e6edf3;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .frontier-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 28px;
    height: 1px;
    background: currentColor;
  }
  .frontier-dropdown summary {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 48px;
    height: 100%;
    min-height: 44px;
    border-bottom: 4px solid transparent;
    cursor: pointer;
    list-style: none;
    color: var(--chrome-link, rgb(var(--text)));
    border-radius: 4px;
  }
  .frontier-dropdown summary svg {
    display: block;
    opacity: 0.8;
  }
  .frontier-dropdown[open] summary {
    border-bottom-color: var(--chrome-active, var(--accent));
  }
  .frontier-dropdown summary::-webkit-details-marker {
    display: none;
  }
  .frontier-dropdown summary:hover,
  .frontier-dropdown[open] summary {
    color: var(--chrome-active, var(--accent));
  }
  .frontier-dropdown summary:hover svg,
  .frontier-dropdown summary:focus-visible svg,
  .frontier-dropdown[open] summary svg {
    opacity: 1;
  }
  .frontier-dropdown summary:focus-visible {
    outline: 1px solid var(--chrome-active, var(--accent));
    outline-offset: -3px;
  }
  .frontier-dropdown[open] summary svg {
    transform: rotate(180deg);
  }
  .frontier-dropdown-links {
    position: absolute;
    top: calc(100% + 4px);
    left: calc(-1.15rem - 1px);
    z-index: 100;
    min-width: 170px;
    padding: 0.35rem;
    border: 1px solid var(--chrome-border, rgb(var(--border)));
    border-radius: 6px;
    background: var(--bg);
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.4);
  }
  .internal-links .frontier-dropdown-links :global(a) {
    display: block;
    padding: 0.65rem 0.8rem;
    border-bottom: none;
    white-space: nowrap;
    font-size: 0.9rem;
    border-radius: 3px;
  }
  .frontier-dropdown-links :global(a:hover),
  .frontier-dropdown-links :global(a:focus-visible) {
    background: color-mix(in srgb, var(--chrome-active, var(--accent)) 15%, transparent);
  }
  .internal-links .frontier-dropdown-links :global(a.active) {
    color: var(--chrome-active, var(--accent));
  }
  header {
    margin: 0;
    padding: 0 1em;
    background: var(--chrome-bg, var(--bg));
    border-bottom: 1px solid var(--chrome-border, rgb(var(--border)));
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
    color: var(--chrome-link, rgb(var(--text)));
    border-bottom: none;
  }
  nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
    min-height: 56px;
    width: 100%;
  }
  .nav-left {
    justify-self: start;
  }
  @media (min-width: 721px) {
    nav:has(.social-menu-wrap :global(a:nth-child(4))) {
      grid-template-columns: auto auto minmax(0, 1fr);
    }
  }
  @media (min-width: 721px) and (max-width: 1100px) {
    nav {
      grid-template-columns: auto auto minmax(0, 1fr);
    }
  }
  .internal-links {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }
  .nav-right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    max-width: 100%;
  }
  .internal-links :global(a) {
    padding: 1em 0.5em;
    color: var(--chrome-link, rgb(var(--text)));
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }
  .internal-links :global(a.active) {
    text-decoration: none;
    border-bottom-color: var(--chrome-active, var(--accent));
  }
  .social-links {
    display: flex;
  }
  .social-links {
    align-items: center;
    gap: 0.4rem;
    position: relative;
    flex-wrap: nowrap;
    min-width: 0;
    --lang-label-color: rgba(190, 226, 248, 0.78);
    --lang-select-arrow: rgba(204, 236, 252, 0.82);
    --lang-select-bg: rgba(9, 22, 40, 0.68);
    --lang-select-border: rgba(132, 214, 255, 0.2);
    --lang-select-text: rgba(204, 236, 252, 0.86);
    --lang-select-focus-border: rgba(132, 214, 255, 0.5);
    --lang-select-focus-ring: rgba(98, 180, 228, 0.18);
    --lang-select-option-text: #ccecfb;
    --lang-select-option-bg: #0b1c32;
  }
  .social-menu-wrap {
    display: inline-flex;
    align-items: center;
    margin-left: 0.45rem;
    min-width: 0;
    overflow: hidden;
  }
  .nav-status {
    display: none;
    align-items: center;
    gap: 0.45rem;
    padding: 0.24rem 0.5rem;
    border-radius: 999px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(186, 232, 252, 0.86);
    background: rgba(6, 16, 30, 0.52);
    border: 1px solid rgba(132, 214, 255, 0.22);
    box-shadow:
      0 0 0 1px rgba(132, 214, 255, 0.08),
      0 0 16px rgba(90, 180, 255, 0.16);
    white-space: nowrap;
    position: absolute;
    right: calc(100% + 0.5rem);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .nav-status-dot {
    width: 0.44rem;
    height: 0.44rem;
    border-radius: 50%;
    background: rgba(150, 226, 255, 0.96);
    box-shadow: 0 0 10px rgba(122, 210, 255, 0.72);
    animation: nav-status-pulse 1.8s steps(1, end) infinite;
  }
  @keyframes nav-status-pulse {
    0%,
    78%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    82% {
      opacity: 0.2;
      transform: scale(0.7);
    }
    86% {
      opacity: 1;
      transform: scale(1.05);
    }
    90% {
      opacity: 0.28;
      transform: scale(0.78);
    }
  }
  body.ai-page .nav-status {
    display: inline-flex;
  }
  body.about-page .nav-status {
    display: none;
  }
  @media (max-width: 720px) {
    nav {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .nav-left {
      display: none;
    }
    .internal-links {
      justify-self: start;
    }
    .nav-right {
      justify-self: end;
    }
    .nav-status {
      display: none !important;
    }
    .social-links {
      display: flex;
    }
    .social-menu-wrap {
      display: none;
    }
    .lang-switcher {
      margin-right: 0;
    }
  }
</style>
