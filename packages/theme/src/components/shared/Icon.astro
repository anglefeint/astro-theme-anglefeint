---
import { SOCIAL_ICON_PATHS, type SocialIcon } from '../../utils/social-icons';
interface Props {
  name?: SocialIcon;
  size?: number;
}
const { name, size = 32 } = Astro.props as Props;
const path = name && Object.hasOwn(SOCIAL_ICON_PATHS, name) ? SOCIAL_ICON_PATHS[name] : undefined;
---

{
  path && (
    <svg viewBox="0 0 16 16" aria-hidden="true" width={size} height={size}>
      <path fill="currentColor" d={path} />
    </svg>
  )
}
