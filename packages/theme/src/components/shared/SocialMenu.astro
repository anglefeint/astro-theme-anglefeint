---
import { SOCIAL_LINKS } from '@anglefeint/site-config/social';
import { publicDir, base } from 'astro:config/server';
import type { SocialLink } from '../../utils/social-icons';
import { resolveSocialLinks } from '../../utils/social-links';
import Icon from './Icon.astro';

interface Props {
  links?: SocialLink[];
  iconSize?: number;
  showPlaceholdersWhenEmpty?: boolean;
  tone?: 'header' | 'footer';
  gap?: string;
}

const {
  links = SOCIAL_LINKS,
  iconSize = 32,
  showPlaceholdersWhenEmpty = true,
  tone = 'header',
  gap = tone === 'header' ? '0.6rem' : '0.85rem',
} = Astro.props as Props;
const placeholderLinks: SocialLink[] = [
  { href: '', label: 'Mastodon', icon: 'mastodon' },
  { href: '', label: 'Twitter', icon: 'twitter' },
  { href: '', label: 'GitHub', icon: 'github' },
];
const resolvedLinks = resolveSocialLinks(
  links.length > 0 || !showPlaceholdersWhenEmpty ? links : placeholderLinks,
  publicDir,
  base
);
---

<div class:list={['social-menu', `social-menu-${tone}`]} style={`--social-gap:${gap};`}>
  {
    resolvedLinks.map((link) =>
      links.length > 0 ? (
        <a href={link.href} aria-label={link.label} target="_blank" rel={link.rel}>
          {link.iconSrc ? (
            <img src={link.iconSrc} alt="" width={iconSize} height={iconSize} />
          ) : link.icon ? (
            <Icon name={link.icon} size={iconSize} />
          ) : (
            <span>{link.label}</span>
          )}
        </a>
      ) : (
        <span class="social-placeholder" aria-hidden="true">
          {link.icon ? <Icon name={link.icon} size={iconSize} /> : <span>{link.label}</span>}
        </span>
      )
    )
  }
</div>

<style>
  .social-menu {
    display: inline-flex;
    flex-wrap: wrap;
    max-width: 100%;
    align-items: center;
    gap: var(--social-gap);
  }

  .social-menu a,
  .social-placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .social-menu a {
    color: rgba(188, 220, 242, 0.82);
    text-decoration: none;
    line-height: 1.4;
    overflow-wrap: anywhere;
    max-width: 100%;
    transition:
      color 0.22s ease,
      transform 0.22s ease,
      filter 0.22s ease;
  }

  .social-menu a:hover {
    color: rgba(228, 242, 255, 0.98);
    transform: translateY(-1px);
    filter: drop-shadow(0 0 12px rgba(132, 214, 255, 0.28));
  }

  .social-menu a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  .social-menu img {
    display: block;
    object-fit: contain;
    flex-shrink: 0;
  }

  .social-menu-header {
    flex-wrap: nowrap;
    overflow-x: auto;
    padding: 5px;
    scrollbar-width: thin;
  }
  .social-menu-header a {
    flex-shrink: 0;
    max-width: none;
    white-space: nowrap;
  }
  .social-menu-footer {
    justify-content: center;
  }

  .social-menu-footer a {
    color: rgba(166, 190, 214, 0.78);
  }

  .social-menu-footer a:hover {
    color: rgba(208, 228, 246, 0.94);
    filter: drop-shadow(0 0 10px rgba(132, 214, 255, 0.2));
  }

  .social-placeholder {
    opacity: 0.45;
    filter: saturate(0.7);
    cursor: default;
  }
</style>
