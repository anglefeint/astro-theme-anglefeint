---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'div'> {
  sizing?: 'container' | 'viewport';
}
const { sizing = 'container', class: className, ...attributes } = Astro.props;
---

<div
  {...attributes}
  class:list={['cyber-dust', className]}
  data-cyber-dust
  data-sizing={sizing}
  aria-hidden="true"
>
</div>
<style is:global>
  .cyber-dust {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: var(--cyber-dust-layer, 0);
    overflow: hidden;
    contain: layout paint;
  }
  [data-cyber-dust] .cyber-dust-particle {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
    background: var(--cyber-dust-color, rgba(176, 216, 248, 0.68));
    box-shadow: var(
      --cyber-dust-shadow,
      0 0 10px rgba(126, 196, 255, 0.35),
      0 0 20px rgba(214, 146, 210, 0.16)
    );
    animation: cyber-dust-float linear infinite;
  }
  @keyframes cyber-dust-float {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 0.7;
    }
    25% {
      transform: translate(15px, -8px) scale(1.1);
      opacity: 0.95;
    }
    50% {
      transform: translate(-10px, -20px) scale(0.9);
      opacity: 0.8;
    }
    75% {
      transform: translate(8px, -15px) scale(1.05);
      opacity: 0.9;
    }
    100% {
      transform: translate(0, -30px) scale(1);
      opacity: 0.7;
    }
  }
  [data-cyber-dust][data-sizing='viewport'] {
    position: fixed;
  }
  [data-cyber-dust][data-dust-paused] .cyber-dust-particle {
    animation-play-state: paused;
  }
  @media (max-width: 720px) {
    [data-cyber-dust] .cyber-dust-particle:nth-child(2n) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-cyber-dust] {
      display: none;
    }
  }
</style>
