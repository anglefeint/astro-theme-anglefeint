---
import { Image } from 'astro:assets';
import coverData from 'virtual:anglefeint-blog-covers';
import { blogCover } from '../utils/blog-cover';
import { hasMathMarkup } from '../utils/math-markup';
import { getCollection, type CollectionEntry } from 'astro:content';
import { resolveArticleLocaleHrefs } from '../utils/article-locales';
import themeRedqueen1 from '../assets/theme/red-queen/theme-redqueen1.webp';
import themeRedqueen2 from '../assets/theme/red-queen/theme-redqueen2.gif';
import FormattedDate from '../components/FormattedDate.astro';
import ArticleToc from '../components/ArticleToc.astro';
import BackToTop from '../components/shared/BackToTop.astro';
import TagLinks from '../components/TagLinks.astro';
import type { MarkdownHeading } from 'astro';
import Giscus from '../components/Giscus.astro';
import { articleComments } from '../utils/comments';
import AiShell from './shells/AiShell.astro';
import AiBackground from '../effects/ai-background/AiBackground.astro';
import RedQueen from '../effects/red-queen/RedQueen.astro';
import blogPostCssUrl from '../styles/blog-post.css?url';
import mathCssUrl from '../styles/math.css?url';
import { SITE_AUTHOR, SITE_TITLE } from '@anglefeint/site-config/site';
import { publicDir } from 'virtual:anglefeint-social';
import { resolveSocialImage } from '../social/resolve.mjs';
import { imageData } from '../social/model.mjs';
import { resolveArticleAuthor } from '../utils/article-author';
import { THEME } from '@anglefeint/site-config/theme';
import {
  DEFAULT_LOCALE,
  type Locale,
  isLocale,
  localePath,
  blogIdToSlugAnyLocale,
} from '@anglefeint/site-i18n/config';
import { getMessages } from '@anglefeint/site-i18n/messages';

type Props = CollectionEntry<'blog'>['data'] & {
  locale?: string;
  articleSlug?: string;
  related?: CollectionEntry<'blog'>[];
  headings?: MarkdownHeading[];
  localeHrefs?: Partial<Record<Locale, string>>;
  seoLocaleHrefs?: Partial<Record<Locale, string>>;
  filePath?: string;
};

const {
  title,
  subtitle,
  description,
  pubDate,
  updatedDate,
  heroImage,
  ogImage,
  context,
  aiModel,
  aiMode,
  aiState,
  wordCount,
  tokenCount,
  author,
  tags,
  toc,
  search = true,
  headings = [],
  articleSlug,
  locale = DEFAULT_LOCALE,
  related = [],
  localeHrefs,
  seoLocaleHrefs,
  filePath,
} = Astro.props;
const articleHtml = await Astro.slots.render('default');
const needsMath = (THEME.MATH?.ENABLED ?? false) && hasMathMarkup(articleHtml);
const cover = heroImage ? blogCover(coverData, filePath, heroImage) : undefined;
const resolvedLocale: Locale = isLocale(locale) ? locale : DEFAULT_LOCALE;
const articleAuthor = resolveArticleAuthor(author, SITE_AUTHOR);
const authorHref =
  THEME.ABOUT_PAGE_ENABLED && articleAuthor === SITE_AUTHOR
    ? localePath(resolvedLocale, '/about/')
    : undefined;
const articleLocaleHrefs = await resolveArticleLocaleHrefs({
  pathname: Astro.url.pathname,
  locale: resolvedLocale,
  seoLocaleHrefs,
  loadPosts: () => getCollection('blog'),
});
const messages = getMessages(resolvedLocale);
const shareImage = await resolveSocialImage({
  override: ogImage,
  enabled: THEME.SOCIAL_IMAGE.ENABLED,
  data: imageData(
    title,
    articleAuthor,
    SITE_TITLE,
    resolvedLocale,
    THEME.FOOTER?.SHOW_CREDITS ?? true
  ),
  fallback: heroImage,
  publicDir,
  base: import.meta.env.BASE_URL,
});

// 终端风格日期
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const compact = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n));
const contextText = context ?? description;
const hasSystemMeta = Boolean(aiModel || aiMode || aiState);
const hasStats = aiModel || wordCount !== undefined || tokenCount !== undefined;
const enableRedQueen = THEME.EFFECTS.ENABLE_RED_QUEEN;
const comments = articleComments(THEME.COMMENTS, articleSlug);
const normalizedCommentTerm = comments.TERM.trim();
const normalizedCommentNumber = comments.NUMBER.trim();
const hasValidCommentNumber =
  /^[1-9]\d*$/.test(normalizedCommentNumber) &&
  Number.isSafeInteger(Number(normalizedCommentNumber));
const hasMappingParam =
  comments.MAPPING === 'specific'
    ? Boolean(normalizedCommentTerm)
    : comments.MAPPING === 'number'
      ? hasValidCommentNumber
      : true;
const hasCommentsConfig = Boolean(
  comments.ENABLED &&
  comments.REPO &&
  comments.REPO_ID &&
  comments.CATEGORY &&
  comments.CATEGORY_ID &&
  hasMappingParam
);
---

<AiShell
  locale={resolvedLocale}
  title={title}
  description={description}
  image={shareImage}
  pageType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  author={articleAuthor}
  tags={tags}
  localeHrefs={localeHrefs}
  seoLocaleHrefs={articleLocaleHrefs}
>
  <link slot="head" rel="stylesheet" href={blogPostCssUrl} />
  {needsMath && <link slot="head" rel="stylesheet" href={mathCssUrl} />}
  <Fragment slot="body-start">
    <AiBackground sizing="viewport" />
    {
      enableRedQueen && (
        <RedQueen
          source={themeRedqueen1.src}
          secondarySource={themeRedqueen2.src}
          badge={messages.blog.rqBadge}
          replayLabel={messages.blog.rqReplayAria}
          placement="article"
        />
      )
    }
    <div class="ai-read-progress" aria-hidden="true"></div>
    <BackToTop label={messages.blog.backToTop} />
    <div
      class="ai-stage-toast"
      aria-live="polite"
      aria-atomic="true"
      data-toast-p10={messages.blog.toastP10}
      data-toast-p30={messages.blog.toastP30}
      data-toast-p60={messages.blog.toastP60}
      data-toast-done={messages.blog.toastDone}
    >
    </div>
    <div class="ai-mouse-glow" aria-hidden="true"></div>
    <div class="ai-depth-blur" aria-hidden="true"></div>
    <div class="ai-thinking-dots" aria-hidden="true"><span></span><span></span><span></span></div>
  </Fragment>
  <div class="ai-load-scan" aria-hidden="true"></div>
  <article class="ai-article" data-machine-readable data-machine-locale={resolvedLocale}>
    <div
      class="prose"
      data-anglefeint-search={search && (THEME.SEARCH?.ENABLED ?? true) ? '' : undefined}
    >
      <div class="title ai-title">
        <h1 class="ai-title-text" data-pagefind-body data-pagefind-meta="title">{title}</h1>
        <div class="ai-meta-terminal">
          $ {messages.blog.metaPublished}
          {fmt(pubDate)}
          {' | '}
          <span class="ai-article-author">
            {messages.blog.metaAuthor}{' '}
            {
              authorHref ? (
                <a href={authorHref} rel="author">
                  {articleAuthor}
                </a>
              ) : (
                <span>{articleAuthor}</span>
              )
            }
          </span>
          {
            updatedDate && (
              <>
                {' '}
                | {messages.blog.metaUpdated} {fmt(updatedDate)}
              </>
            )
          }
        </div>
        {
          hasSystemMeta && (
            <div class="ai-system-row" aria-label={messages.blog.systemStatusAria}>
              {aiModel && (
                <span class="ai-system-chip">
                  {messages.blog.systemModelLabel}: {aiModel}
                </span>
              )}
              {aiMode && (
                <span class="ai-system-chip">
                  {messages.blog.systemModeLabel}: {aiMode}
                </span>
              )}
              {aiState && (
                <span class="ai-system-chip">
                  {messages.blog.systemStateLabel}: {aiState}
                </span>
              )}
            </div>
          )
        }
        {
          contextText && (
            <div class="ai-prompt-line">
              {messages.blog.promptContextLabel}:{' '}
              <span
                class="ai-prompt-topic"
                data-pagefind-body={subtitle === contextText ? '' : undefined}
              >
                {contextText}
              </span>
            </div>
          )
        }
        {
          subtitle && subtitle !== contextText && (
            <p class="ai-subtitle-text" data-pagefind-body>
              {subtitle}
            </p>
          )
        }
        <hr />
        <div class="ai-title-flow" aria-hidden="true"></div>
      </div>
      {
        heroImage && (
          <div class="hero-shell">
            <div class="hero-pane">
              <div class="hero-image">
                <div class="hero-stack">
                  <div class="hero-base-wrap">
                    <img
                      class="hero-base-image"
                      {...cover}
                      sizes="(max-width: 820px) calc(100vw - 3rem), 780px"
                      alt=""
                      loading="eager"
                      decoding="async"
                      fetchpriority="high"
                    />
                  </div>
                  <div class="hero-canvas-wrap" aria-hidden="true">
                    <canvas class="hero-canvas" />
                  </div>
                </div>
                <div class="hero-frame" aria-hidden="true">
                  <span>{messages.blog.heroMonitor}</span>
                  <span class="hero-frame-dot" />
                </div>
              </div>
              <div class="hero-threat-bar" aria-hidden="true">
                <span>{messages.blog.heroSignalSync}</span>
                <span>{messages.blog.heroModelOnline}</span>
              </div>
            </div>
          </div>
        )
      }
      <ArticleToc
        headings={headings}
        enabled={toc ?? THEME.TOC?.ENABLED ?? true}
        label={messages.blog.toc}
      />
      <div class="ai-response-wrap">
        <div class="ai-response-header">
          <div class="ai-response-avatar" aria-hidden="true"></div>
          <span class="ai-response-label">{messages.blog.responseOutput}</span>
          {
            hasStats && (
              <div class="ai-response-meta">
                {aiModel && (
                  <span class="ai-model-id">
                    {messages.blog.systemModelLabel} <strong>{aiModel}</strong>
                  </span>
                )}
                {wordCount !== undefined && (
                  <span>
                    {messages.blog.statsWords} <strong>{compact(wordCount)}</strong>
                  </span>
                )}
                {tokenCount !== undefined && (
                  <span>
                    {messages.blog.statsTokens} <strong>{compact(tokenCount)}</strong>
                  </span>
                )}
              </div>
            )
          }
        </div>
        {THEME.TAGS.ENABLED && <TagLinks locale={resolvedLocale} tags={tags ?? []} article />}
        <div
          class="ai-prose-body ai-prose-fade"
          data-code-copy={JSON.stringify(messages.codeCopy)}
          data-image-preview={JSON.stringify(messages.imagePreview)}
          data-section-links={JSON.stringify({
            copy: messages.blog.copySectionLink,
            copied: messages.codeCopy.copied,
            failed: messages.codeCopy.failed,
          })}
          data-pagefind-body
        >
          <Fragment set:html={articleHtml} />
          <span class="ai-block-cursor" aria-hidden="true"></span>
        </div>
      </div>
      <button
        type="button"
        class="ai-regenerate"
        aria-label={messages.blog.regenerate}
        title={messages.blog.regenerate}>{messages.blog.regenerate}</button
      >
    </div>
  </article>
  {
    related.length > 0 && (
      <section class="ai-related" aria-label={messages.blog.relatedAria}>
        <h2 class="ai-related-title">{messages.blog.related}</h2>
        <div class="ai-related-grid">
          {related.map((p) => (
            <a
              href={localePath(resolvedLocale, `/blog/${blogIdToSlugAnyLocale(p.id)}`)}
              class="ai-related-card"
            >
              {p.data.heroImage ? (
                <div class="ai-related-img">
                  <Image width={320} height={180} src={p.data.heroImage} alt="" />
                </div>
              ) : (
                <div class="ai-related-placeholder">
                  <span>{p.data.title.charAt(0)}</span>
                </div>
              )}
              <h3 class="ai-related-card-title">{p.data.title}</h3>
              <p class="ai-related-card-date">
                <FormattedDate date={p.data.pubDate} locale={resolvedLocale} />
              </p>
            </a>
          ))}
        </div>
      </section>
    )
  }
  <nav class="ai-back-to-blog" aria-label={messages.blog.backToBlogAria}>
    <a href={localePath(resolvedLocale, '/blog/')}>
      <span class="ai-back-prompt">$</span>
      <span class="ai-back-text">← {messages.blog.backToBlog}</span>
    </a>
  </nav>
  {
    hasCommentsConfig && (
      <section class="prose ai-comments" aria-label={messages.blog.comments}>
        <Giscus comments={comments} resolvedLocale={resolvedLocale} />
      </section>
    )
  }
  <Fragment slot="body-end">
    <script>
      import { initBlogpostEffects } from '../scripts/blogpost-effects.js';
      initBlogpostEffects();
    </script>
  </Fragment>
</AiShell>
