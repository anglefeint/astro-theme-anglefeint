---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import { fragmentsForLocale } from '../utils/fragments';
import { fragmentPreview } from '../utils/fragment-preview';
import imageData from 'virtual:anglefeint-blog-covers';
import { rewriteFragmentImages } from '../covers/fragment-render.mjs';
import FormattedDate from '../components/FormattedDate.astro';
import FragmentSignal from '../components/FragmentSignal.astro';
import fragmentAvatar from '../assets/theme/avatars/matrix-typist.gif?url';
import fragmentAvatarStill from '../assets/theme/avatars/matrix-typist-still.png?url';
import fragmentAvatarReaction from '../assets/theme/avatars/matrix-typist-hover-strip.png?url';
import HomeWhiteRabbit from '../components/HomeWhiteRabbit.astro';
import KeyButton from '../effects/key-button/KeyButton.astro';
import BlinkCursor from '../effects/blink-cursor/BlinkCursor.astro';
import StartupText from '../effects/startup-text/StartupText.astro';
import HiddenSignal from '../effects/hidden-signal/HiddenSignal.astro';
import {
  SITE_DESCRIPTION,
  SITE_TITLE,
  getHomeTitle,
  getSiteHero,
} from '@anglefeint/site-config/site';
import { type Locale, blogIdToSlugAnyLocale, localePath } from '@anglefeint/site-i18n/config';
import { getMessages } from '@anglefeint/site-i18n/messages';
import MatrixShell from './shells/MatrixShell.astro';
import { THEME } from '@anglefeint/site-config/theme';

interface Props {
  locale: Locale;
  latestPosts: CollectionEntry<'blog'>[];
  totalPosts?: number;
}

const { locale, latestPosts, totalPosts = latestPosts.length } = Astro.props;
const messages = getMessages(locale);
const heroText = getSiteHero(locale) ?? messages.home.hero;
const pageDescription = messages.siteDescription || SITE_DESCRIPTION;
const fragments = THEME.FRAGMENTS.enabled
  ? fragmentsForLocale(await getCollection('fragments'), locale)
  : [];
const latestFragments: {
  entry: CollectionEntry<'fragments'>;
  preview: ReturnType<typeof fragmentPreview>;
}[] = [];
if (fragments.length) {
  const container = await AstroContainer.create();
  const feedURL = new URL(localePath(locale, '/fragments/'), Astro.url);
  for (const entry of fragments.slice(0, 3)) {
    const { Content } = await render(entry);
    const html = rewriteFragmentImages(await container.renderToString(Content), imageData);
    latestFragments.push({ entry, preview: fragmentPreview(html, feedURL) });
  }
}
---

<MatrixShell locale={locale} title={SITE_TITLE} description={pageDescription}>
  <Fragment slot="head">
    {
      latestFragments.length > 0 && (
        <link
          rel="preload"
          as="image"
          href={fragmentAvatarReaction}
          media="(prefers-reduced-motion: no-preference)"
        />
      )
    }
  </Fragment>
  <div slot="signal-monitor" class="home-signal-monitor">
    <div class="home-signal-viewport" data-door-label={messages.home.openDoor} inert></div>
    <div class="home-signal-code" aria-hidden="true">
      {
        [0, 1, 2, 3, 4, 5].map((column) => (
          <span style={`--signal-column: ${column}`}>0101 ZN7 1010 RX 0011</span>
        ))
      }
    </div>
    <div class="home-signal-scroll" tabindex="0">
      <span class="home-signal-message">{messages.home.transmission}</span>
    </div>
    <KeyButton class="home-signal-enter" label={messages.home.openDoor} />
  </div>
  <button class="home-mirror-surface" type="button" aria-label="Repair mirror">
    <canvas class="home-mirror" aria-hidden="true"></canvas>
  </button>
  {
    (THEME.HOME.SHOW_INITIALIZE || THEME.HOME.SHOW_FOLLOW) && (
      <StartupText
        class="home-terminal-intro"
        config={{
          startup: THEME.HOME.SHOW_INITIALIZE ? undefined : [],
          message: THEME.HOME.SHOW_FOLLOW ? undefined : [],
        }}
      />
    )
  }
  <h1 class="home-wordmark">{getHomeTitle(locale)}</h1>
  <p class="home-hero-copy">{heroText}</p>

  <section class="home-latest">
    <div class="home-latest-heading">
      <h2 class="home-section-title">
        {messages.home.latest}<BlinkCursor
          shape="underline"
          period={1400}
          style="--cursor-gap:0.4ch"
        />
      </h2>
      <span class="home-latest-count" title={messages.blog.allPosts}
        >{String(latestPosts.length).padStart(2, '0')} / {String(totalPosts).padStart(2, '0')}</span
      >
    </div>
    <ul
      class="home-post-list"
      data-home-passage-enabled={String(THEME.EFFECTS.ENABLE_HOME_PASSAGE)}
    >
      {
        latestPosts.length > 0 ? (
          latestPosts.map((post, index) => (
            <li class="home-post-record" data-decode={['scatter', 'rain', 'rebuild'][index % 3]}>
              <a
                class="home-post-title"
                href={localePath(locale, `/blog/${blogIdToSlugAnyLocale(post.id)}`)}
              >
                {post.data.title}
              </a>
              <HomeWhiteRabbit />
              <div class="home-post-meta">
                <FormattedDate date={post.data.pubDate} locale={locale} />
                {post.data.description && <> · {post.data.description}</>}
              </div>
            </li>
          ))
        ) : (
          <li>{messages.home.noPosts}</li>
        )
      }
    </ul>
    <p class="home-archive-row">
      <a
        class="home-archive-command"
        data-decode="scan"
        href={localePath(locale, '/blog/')}
        aria-label={messages.blog.allPosts}
        ><HomeWhiteRabbit /><span class="home-archive-label">{messages.home.viewAll}</span><span
          class="home-archive-arrow"
          aria-hidden="true">→</span
        ></a
      >
    </p>
  </section>
  <Fragment slot="fragment-signal">
    {
      latestFragments.length > 0 && (
        <FragmentSignal
          totalCount={fragments.length}
          avatar={{
            src: fragmentAvatar,
            stillSrc: fragmentAvatarStill,
            reactionSrc: fragmentAvatarReaction,
          }}
          archiveHref={localePath(locale, '/fragments/')}
          entries={latestFragments.map(({ entry, preview }) => ({
            href: `${localePath(locale, '/fragments/')}#${entry.data.id}`,
            date: entry.data.pubDate,
            title: entry.data.title,
            preview,
          }))}
          labels={{
            title: messages.fragments.title,
            close: messages.fragments.close,
            all: messages.home.viewAll,
          }}
        />
      )
    }
  </Fragment>
  {
    THEME.HOME.SHOW_TRACE && (
      <div class="home-terminal-status">
        <HiddenSignal class="home-pirate-signal" aria-hidden="true">
          <span class="home-signal-prompt">&gt;</span> PIRATE SIGNAL
        </HiddenSignal>
        <HiddenSignal class="home-trace-text">
          <span aria-hidden="true">&gt; </span>
          <span class="home-trace-label">TRACE PROGRAM: RUNNING</span>{' '}
          <span class="home-trace-result">
            <span class="home-trace-decode">3 1 2) 5 5 5 0 6 9 0</span>
            <BlinkCursor class="home-trace-cursor" active={false} style="--cursor-gap:1ch" />
          </span>
        </HiddenSignal>
      </div>
    )
  }
</MatrixShell>
