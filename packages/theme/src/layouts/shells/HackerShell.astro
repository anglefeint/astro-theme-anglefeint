---
import type { Locale } from '@anglefeint/site-i18n/config';
import ThemeFrame from '../../components/shared/ThemeFrame.astro';
import aboutPageCssUrl from '../../styles/about-page.css?url';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
  bodyClass?: string;
  localeHrefs?: Partial<Record<Locale, string>>;
}

const { locale, title, description, bodyClass = 'hacker-page', localeHrefs } = Astro.props as Props;
---

<ThemeFrame
  locale={locale}
  title={title}
  description={description}
  bodyClass={bodyClass}
  mainClass="page-main hacker-content"
  localeHrefs={localeHrefs}
>
  <link slot="head" rel="stylesheet" href={aboutPageCssUrl} />
  <slot name="head" slot="head" />
  <slot name="body-start" slot="body-start" />
  <slot />
  <slot name="body-end" slot="body-end" />
</ThemeFrame>
