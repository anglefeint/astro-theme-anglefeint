---
import type { Locale } from '@anglefeint/site-i18n/config';
import ThemeFrame from '../../components/shared/ThemeFrame.astro';
import homePageCssUrl from '../../styles/home-page.css?url';

interface Props {
  locale?: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props as Props;
---

<ThemeFrame
  locale={locale}
  title={title}
  description={description}
  bodyClass="page-home"
  mainClass="page-main home-content"
>
  <Fragment slot="head">
    <link rel="stylesheet" href={homePageCssUrl} />
    <slot name="head" />
  </Fragment>
  <canvas slot="body-start" id="matrix-bg" aria-hidden="true"></canvas>
  <Fragment slot="body-end">
    <slot name="signal-monitor" />
    <slot name="fragment-signal" />
    <script>
      import { initHomeEffects } from '../../scripts/home-effects.js';
      initHomeEffects();
    </script>
  </Fragment>
  <slot />
</ThemeFrame>
