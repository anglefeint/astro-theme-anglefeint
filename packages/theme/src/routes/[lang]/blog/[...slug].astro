---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BlogPost from '@anglefeint/astro-theme/layouts/BlogPost.astro';
import { countWords, deriveMetrics } from '@anglefeint/astro-theme/utils/metrics';
import {
  alternatePathForLocale,
  DEFAULT_LOCALE,
  ENABLED_LOCALES,
  type Locale,
  blogIdToSlugAnyLocale,
  isLocale,
  localePath,
} from '@anglefeint/site-i18n/config';
import { buildArticlePaths } from '../../../utils/article-paths';

export const getStaticPaths = (async () => {
  return buildArticlePaths(await getCollection('blog'), {
    locales: ENABLED_LOCALES,
    slugOf: blogIdToSlugAnyLocale,
    menuPath: alternatePathForLocale,
    seoPath: localePath,
  });
}) satisfies GetStaticPaths;
const { post, related, locale, articleSlug, localeHrefs, seoLocaleHrefs } = Astro.props;
const lang = (Astro.params.lang ?? locale ?? DEFAULT_LOCALE) as string;
const resolvedLocale: Locale = isLocale(lang) ? lang : DEFAULT_LOCALE;
const { Content, headings } = await render(post);

const computed = deriveMetrics(countWords(post.body ?? ''));
const resolvedData = {
  ...post.data,
  locale: resolvedLocale,
  wordCount: post.data.wordCount ?? computed.wordCount,
  tokenCount: post.data.tokenCount ?? computed.tokenCount,
};
---

<BlogPost
  articleSlug={articleSlug}
  filePath={post.filePath}
  {...resolvedData}
  headings={headings}
  related={related}
  localeHrefs={localeHrefs}
  seoLocaleHrefs={seoLocaleHrefs}
>
  <Content />
</BlogPost>
