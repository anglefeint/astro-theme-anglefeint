---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import CyberShell from '../../../layouts/shells/CyberShell.astro';
import FragmentComments from '../../../components/FragmentComments.astro';
import CyberPagination from '../../../components/pagination/CyberPagination.astro';
import mathCssUrl from '../../../styles/math.css?url';
import { fragmentTerm } from '../../../utils/fragments';
import { buildFragmentIndex } from '../../../utils/fragment-index';
import { buildPaginationModel } from '../../../utils/pagination';
import { THEME } from '@anglefeint/site-config/theme';
import { SITE_TITLE } from '@anglefeint/site-config/site';
import { ENABLED_LOCALES, localePath, getLocaleHreflang } from '@anglefeint/site-i18n/config';
import { getMessages } from '@anglefeint/site-i18n/messages';

export const getStaticPaths = (async () => {
  if (!THEME.FRAGMENTS.enabled) return [];
  const entries = await getCollection('fragments');
  return ENABLED_LOCALES.flatMap((locale) => {
    const {
      entries: localized,
      totalPages: total,
      revision,
    } = buildFragmentIndex(entries, locale, THEME.FRAGMENTS.pageSize);
    return Array.from({ length: total }, (_, index) => ({
      params: { lang: locale, page: index ? String(index + 1) : undefined },
      props: {
        locale,
        current: index + 1,
        total,
        indexHref: `${localePath(locale, '/fragments/')}index/${revision}.json`,
        entries: localized.slice(
          index * THEME.FRAGMENTS.pageSize,
          (index + 1) * THEME.FRAGMENTS.pageSize
        ),
      },
    }));
  });
}) satisfies GetStaticPaths;

const { locale, current, total, entries, indexHref } = Astro.props;
const feedHref = localePath(locale, '/fragments/');
const messages = getMessages(locale);
const labels = messages.fragments;
const paginationModel = buildPaginationModel({
  currentPage: current,
  totalPages: total,
  windowSize: THEME.PAGINATION.WINDOW_SIZE,
  showJumpThreshold: THEME.PAGINATION.SHOW_JUMP_THRESHOLD,
});
const cards = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
// Locale switches always target page one: pagination counts may differ by language.
const localeHrefs = Object.fromEntries(
  ENABLED_LOCALES.map((code) => [code, localePath(code, '/fragments/')])
);
// Preserve the localized word while arranging it as a few quiet, separate pieces.
const titleGlyphs = Array.from(
  new Intl.Segmenter(undefined, { granularity: 'grapheme' }).segment(labels.title),
  (part) => part.segment
);
const titlePartCount = Math.min(3, titleGlyphs.length);
const titleParts = Array.from({ length: titlePartCount }, (_, index) =>
  titleGlyphs
    .slice(
      Math.round((index * titleGlyphs.length) / titlePartCount),
      Math.round(((index + 1) * titleGlyphs.length) / titlePartCount)
    )
    .join('')
);
---

<CyberShell
  locale={locale}
  title={`${labels.title} | ${SITE_TITLE}`}
  description={labels.description}
  localeHrefs={localeHrefs}
  includeAlternateLinks={current === 1}
>
  {THEME.MATH.ENABLED && <link slot="head" rel="stylesheet" href={mathCssUrl} />}
  <section
    class="fragments-feed"
    data-fragments
    data-fragment-root={feedHref}
    data-fragment-page={current}
    data-fragment-index={indexHref}
    data-fragment-link-labels={JSON.stringify({
      copy: labels.copyLink,
      copied: labels.linkCopied,
      failed: labels.copyLinkFailed,
      missing: labels.notFound,
      indexError: labels.indexError,
    })}
  >
    <div class="fragments-heading">
      <h1 aria-label={labels.title}>
        {titleParts.map((part) => <span class="fragment-title-part">{part}</span>)}
      </h1>
      <p class="fragments-description">{labels.description}</p>
    </div>
    <p class="fragment-link-status" data-fragment-link-status role="status" hidden></p>
    {!cards.length && <p>{labels.empty}</p>}
    {
      cards.map(({ entry, Content }) => (
        <article
          class="fragment-card"
          id={`fragment-${entry.data.id}`}
          data-fragment-id={entry.data.id}
          tabindex="-1"
        >
          <div class="fragment-meta">
            <a
              class="fragment-date"
              data-fragment-link
              href={`${feedHref}#fragment-${entry.data.id}`}
            >
              <time datetime={entry.data.pubDate.toISOString()}>
                {entry.data.pubDate.toLocaleString(getLocaleHreflang(locale), {
                  dateStyle: 'medium',
                  timeStyle: 'short',
                  timeZone: 'UTC',
                })}{' '}
                UTC
              </time>
            </a>
            <button
              type="button"
              class="fragment-copy"
              data-fragment-copy
              hidden
              title={labels.copyLink}
              aria-label={labels.copyLink}
            >
              <svg
                data-copy-icon
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path
                  d="m10 13 4-4M8 15l-1 1a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m2 3 1-1a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0"
                  transform="translate(1 0)"
                />
              </svg>
              <svg
                data-copied-icon
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="m5 12 4 4L19 6" />
              </svg>
            </button>
            <span class="fragment-copy-status" data-fragment-copy-status role="status" />
          </div>
          <div class="fragment-copy-fallback" data-fragment-copy-feedback hidden />
          {entry.data.title && <h2>{entry.data.title}</h2>}
          <div class="fragment-body">
            <Content />
          </div>
          {THEME.FRAGMENTS.comments.enabled && (
            <button
              type="button"
              data-fragment-comments
              data-fragment-term={fragmentTerm(entry.data.id)}
              aria-haspopup="dialog"
              aria-controls="fragment-comments-dialog"
            >
              {labels.comments}
            </button>
          )}
        </article>
      ))
    }
    {
      total > 1 && (
        <CyberPagination
          model={paginationModel}
          locale={locale}
          blogRoot={feedHref}
          pathname={Astro.url.pathname}
          labels={{
            previous: messages.blog.previous,
            next: messages.blog.next,
            paginationAria: messages.blog.paginationAria,
            jumpTo: messages.blog.jumpTo || 'Jump to page',
            jumpInputLabel: messages.blog.jumpInputLabel || 'Page number',
            jumpGo: messages.blog.jumpGo || 'Go',
          }}
          config={{
            jump: {
              enabled: THEME.PAGINATION.JUMP.ENABLED,
              enterToGo: THEME.PAGINATION.JUMP.ENTER_TO_GO,
            },
            style: {
              enabled: THEME.PAGINATION.STYLE.ENABLED,
              mode: THEME.PAGINATION.STYLE.MODE,
              variants: THEME.PAGINATION.STYLE.VARIANTS,
              fixedVariant: THEME.PAGINATION.STYLE.FIXED_VARIANT,
            },
          }}
        />
      )
    }
  </section>
  {THEME.FRAGMENTS.comments.enabled && <FragmentComments locale={locale} labels={labels} />}
</CyberShell>
<script>
  import { initFragmentLinks } from '../../../scripts/fragment-links.js';
  initFragmentLinks();
  document.addEventListener('astro:page-load', initFragmentLinks);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) initFragmentLinks();
  });
</script>
<style>
  .fragments-feed {
    max-width: 850px;
    margin: 0.65rem auto 1rem;
  }
  .fragments-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin-bottom: 1.35rem;
  }
  h1 {
    position: relative;
    margin: 0;
    color: #d3e0e3;
    font:
      700 clamp(1.65rem, 4vw, 2.4rem) / 1.15 ui-monospace,
      monospace;
    letter-spacing: 0.025em;
  }
  .fragment-title-part {
    position: relative;
    display: inline-block;
  }
  .fragment-title-part + .fragment-title-part {
    margin-left: 0.08em;
  }
  .fragment-title-part:nth-child(2) {
    color: #b5ced4;
    transform: translateY(-1px) rotate(-1deg);
  }
  .fragment-title-part:nth-child(3) {
    color: #93b7c0;
    transform: translateY(1px);
  }
  .fragment-title-part::after {
    content: '';
    position: absolute;
    left: 0.08em;
    right: 0.04em;
    bottom: -0.12em;
    height: 1px;
    background: linear-gradient(90deg, currentColor, transparent);
    opacity: 0.3;
    transform: rotate(-3deg);
  }
  .fragments-description {
    flex: 1 1 13rem;
    position: relative;
    margin: 0;
    padding-left: 0.75rem;
    border-left: 1px solid #73969f55;
    color: #9fb2bb;
    font:
      0.8rem / 1.45 ui-monospace,
      monospace;
    letter-spacing: 0.025em;
  }
  .fragments-description::before {
    content: '';
    position: absolute;
    top: 0.2em;
    left: -2px;
    width: 3px;
    height: 0.4em;
    background: #91b8bd;
  }
  .fragment-card {
    position: relative;
    scroll-margin-top: 6rem;
    margin: 0.65rem 0;
    padding: clamp(0.8rem, 1.8vw, 1rem);
    border: 1px solid transparent;
    background: #07131ae8;
    overflow-wrap: anywhere;
    display: flow-root;
  }
  time {
    color: inherit;
    font-size: 0.75rem;
  }
  .fragment-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 1.5em;
  }
  .fragment-date {
    color: #a9bcc8;
    text-decoration: none;
    transition:
      color 0.2s,
      text-shadow 0.2s;
  }
  .fragment-date:is(:hover, :focus-visible) {
    color: #adffff;
    text-decoration: none;
    text-shadow: 0 0 8px #7feaff66;
  }
  .fragment-copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 3px;
    color: #a9bcc8;
    background: transparent;
  }
  .fragment-copy:hover {
    color: #adffff;
  }
  .fragment-copy[hidden] {
    display: none;
  }
  .fragment-copy [data-copied-icon],
  .fragment-copy[data-copied] [data-copy-icon] {
    display: none;
  }
  .fragment-copy[data-copied] [data-copied-icon] {
    display: block;
  }
  .fragment-copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .fragment-link-status {
    margin: 0.45rem 0;
    color: #a9bcc8;
    font-size: 0.8rem;
  }
  .fragment-copy-fallback {
    margin-top: 0.25rem;
  }
  .fragment-copy-fallback :global(input) {
    box-sizing: border-box;
    width: 100%;
    padding: 0.3rem 0.5rem;
    border: 1px solid #58e5ee66;
    border-radius: 4px;
    background: #0a2532;
    color: #adffff;
    font: inherit;
    font-size: 0.75rem;
  }
  h2 {
    margin: 0.45rem 0;
    font-size: 1.05rem;
    line-height: 1.35;
  }
  .fragment-body {
    margin: 0.45rem 0;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .fragment-body :global(p) {
    margin: 0.4rem 0;
    line-height: inherit;
  }
  .fragment-body > :global(:first-child) {
    margin-top: 0;
  }
  .fragment-body > :global(:last-child) {
    margin-bottom: 0;
  }
  .fragment-body :global(ul),
  .fragment-body :global(ol) {
    display: block;
    margin: 0.4rem 0;
    padding-left: 1.3rem;
    list-style: revert;
  }
  .fragment-body :global(li) {
    width: auto;
    margin: 0.12rem 0;
    text-align: start;
    line-height: inherit;
  }
  .fragment-body :global(blockquote) {
    margin: 0.5rem 0;
    padding-left: 0.8rem;
    border-left: 2px solid #74d8df66;
  }
  .fragment-body :global(h3) {
    margin: 0.55rem 0 0.35rem;
    font-size: 1rem;
    line-height: 1.4;
  }
  .fragment-body :global(p code) {
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .fragment-body :global(img) {
    max-width: 100%;
    height: auto;
  }
  .fragment-body :global(pre) {
    margin: 0.5rem 0;
    overflow-x: auto;
  }
  .fragment-body :global(a) {
    color: #7cffff;
    text-decoration: underline;
  }
  .fragment-card [data-fragment-comments] {
    --fragment-comment-border: #607b87;
    position: relative;
    float: right;
    margin: 0.25rem 0 0 0.5rem;
    padding: 0.3rem 0.65rem;
    font-size: 0.75rem;
    line-height: 1.4;
    border: 1px solid var(--fragment-comment-border);
    border-radius: 0;
    clip-path: polygon(5px 0, 100% 0, 100% calc(100% - 5px), calc(100% - 5px) 100%, 0 100%, 0 5px);
    color: #abc0ca;
    background: #7dbecd06;
    box-shadow: none;
    animation: none;
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }
  .fragment-card [data-fragment-comments]::before,
  .fragment-card [data-fragment-comments]::after {
    content: '';
    position: absolute;
    width: 7px;
    height: 7px;
    background: linear-gradient(
      135deg,
      transparent calc(50% - 1px),
      var(--fragment-comment-border) 50%,
      transparent calc(50% + 1px)
    );
    pointer-events: none;
  }
  .fragment-card [data-fragment-comments]::before {
    top: -1px;
    left: -1px;
  }
  .fragment-card [data-fragment-comments]::after {
    bottom: -1px;
    right: -1px;
  }
  .fragment-card [data-fragment-comments]:is(:hover, :focus-visible) {
    --fragment-comment-border: #78dfec;
    color: #adffff;
    background: #7debff0d;
  }
  .fragment-card [data-fragment-comments]:focus-visible {
    outline: 1px solid #adffff;
    outline-offset: -3px;
  }
  button {
    padding: 0.5rem 0.9rem;
    border: 1px solid #58e5ee88;
    border-radius: 6px;
    color: #adffff;
    background: #0a2532;
    cursor: pointer;
  }
  :is(button, a):focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
</style>
