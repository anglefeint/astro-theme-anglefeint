---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';
import { hasMathMarkup } from '../../../utils/math-markup';
import { fragmentFeedHtml } from '../../../utils/fragment-html';
import imageData from 'virtual:anglefeint-blog-covers';
import { rewriteFragmentImages } from '../../../covers/fragment-render.mjs';
import CyberShell from '../../../layouts/shells/CyberShell.astro';
import fragmentsSpaceUrl from '../../../assets/theme/backgrounds/fragments-space-v21.webp?url';
import FragmentComments from '../../../components/FragmentComments.astro';
import BackToTop from '../../../components/shared/BackToTop.astro';
import CyberPagination from '../../../components/pagination/CyberPagination.astro';
import mathCssUrl from '../../../styles/math.css?url';
import { fragmentTerm } from '../../../utils/fragments';
import { buildFragmentIndex } from '../../../utils/fragment-index';
import { buildPaginationModel } from '../../../utils/pagination';
import { THEME } from '@anglefeint/site-config/theme';
import { SITE_TITLE } from '@anglefeint/site-config/site';
import { ENABLED_LOCALES, localePath, getLocaleHreflang } from '@anglefeint/site-i18n/config';
import { getMessages } from '@anglefeint/site-i18n/messages';

export const getStaticPaths = (async () => {
  if (!THEME.FRAGMENTS.enabled) return [];
  const entries = await getCollection('fragments');
  return ENABLED_LOCALES.flatMap((locale) => {
    const {
      entries: localized,
      totalPages: total,
      revision,
    } = buildFragmentIndex(entries, locale, THEME.FRAGMENTS.pageSize);
    return Array.from({ length: total }, (_, index) => ({
      params: { lang: locale, page: index ? String(index + 1) : undefined },
      props: {
        locale,
        current: index + 1,
        total,
        indexHref: `${localePath(locale, '/fragments/')}index/${revision}.json`,
        entries: localized.slice(
          index * THEME.FRAGMENTS.pageSize,
          (index + 1) * THEME.FRAGMENTS.pageSize
        ),
      },
    }));
  });
}) satisfies GetStaticPaths;

const { locale, current, total, entries, indexHref } = Astro.props;
const feedHref = localePath(locale, '/fragments/');
const messages = getMessages(locale);
const labels = messages.fragments;
const paginationModel = buildPaginationModel({
  currentPage: current,
  totalPages: total,
  windowSize: THEME.PAGINATION.WINDOW_SIZE,
  showJumpThreshold: THEME.PAGINATION.SHOW_JUMP_THRESHOLD,
});
const container = await AstroContainer.create();
let hasImage = false;
const cards = [];
for (const entry of entries) {
  const { Content } = await render(entry);
  const rendered = fragmentFeedHtml(
    rewriteFragmentImages(await container.renderToString(Content), imageData),
    !hasImage
  );
  hasImage ||= rendered.hasImage;
  cards.push({ entry, html: rendered.html });
}
const needsMath = THEME.MATH.ENABLED && cards.some(({ html }) => hasMathMarkup(html));
// Locale switches always target page one: pagination counts may differ by language.
const localeHrefs = Object.fromEntries(
  ENABLED_LOCALES.map((code) => [code, localePath(code, '/fragments/')])
);
// Preserve the localized word while arranging it as a few quiet, separate pieces.
const titleGlyphs = Array.from(
  new Intl.Segmenter(undefined, { granularity: 'grapheme' }).segment(labels.title),
  (part) => part.segment
);
// Keep punctuation and whitespace intact while giving subtitle phrases a quiet offset.
const descriptionParts = labels.description.match(
  /[^,，、。.!！?？;；]+[,，、。.!！?？;；]*\s*/gu
) ?? [labels.description];
const titlePartCount = Math.min(3, titleGlyphs.length);
const titleParts = Array.from({ length: titlePartCount }, (_, index) =>
  titleGlyphs
    .slice(
      Math.round((index * titleGlyphs.length) / titlePartCount),
      Math.round(((index + 1) * titleGlyphs.length) / titlePartCount)
    )
    .join('')
);
---

<CyberShell
  locale={locale}
  title={`${labels.title} | ${SITE_TITLE}`}
  description={labels.description}
  localeHrefs={localeHrefs}
  includeAlternateLinks={current === 1}
>
  <div
    slot="body-start"
    class="fragments-space"
    style={{ backgroundImage: `url("${fragmentsSpaceUrl}")` }}
    aria-hidden="true"
  >
  </div>
  {needsMath && <link slot="head" rel="stylesheet" href={mathCssUrl} />}
  <section
    class="fragments-feed"
    data-machine-page="fragments"
    data-machine-locale={locale}
    data-fragments
    data-fragment-root={feedHref}
    data-fragment-page={current}
    data-fragment-index={indexHref}
    data-fragment-link-labels={JSON.stringify({
      copy: labels.copyLink,
      copied: labels.linkCopied,
      failed: labels.copyLinkFailed,
      missing: labels.notFound,
      indexError: labels.indexError,
    })}
  >
    <div class="fragments-heading">
      <h1 aria-label={labels.title}>
        {titleParts.map((part) => <span class="fragment-title-part">{part}</span>)}
      </h1>
      <p class="fragments-description">
        {descriptionParts.map((part) => <span class="fragment-description-part">{part}</span>)}
      </p>
    </div>
    <p class="fragment-link-status" data-fragment-link-status role="status" hidden></p>
    {!cards.length && <p>{labels.empty}</p>}
    {
      cards.map(({ entry, html }) => (
        <article
          class="fragment-card"
          id={entry.data.id}
          data-fragment-id={entry.data.id}
          tabindex="-1"
        >
          <div class="fragment-meta">
            <a class="fragment-date" data-fragment-link href={`${feedHref}#${entry.data.id}`}>
              <time datetime={entry.data.pubDate.toISOString()}>
                {entry.data.pubDate.toLocaleString(getLocaleHreflang(locale), {
                  dateStyle: 'medium',
                  timeStyle: 'short',
                  timeZone: 'UTC',
                })}{' '}
                UTC
              </time>
            </a>
            <button
              type="button"
              class="fragment-copy"
              data-fragment-copy
              hidden
              title={labels.copyLink}
              aria-label={labels.copyLink}
            >
              <svg
                data-copy-icon
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path
                  d="m10 13 4-4M8 15l-1 1a4 4 0 0 1-6-6l4-4a4 4 0 0 1 6 0m2 3 1-1a4 4 0 0 1 6 6l-4 4a4 4 0 0 1-6 0"
                  transform="translate(1 0)"
                />
              </svg>
              <svg
                data-copied-icon
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="m5 12 4 4L19 6" />
              </svg>
            </button>
            <span class="fragment-copy-status" data-fragment-copy-status role="status" />
          </div>
          <div class="fragment-copy-fallback" data-fragment-copy-feedback hidden />
          {entry.data.title && <h2>{entry.data.title}</h2>}
          <div class="fragment-body">
            <Fragment set:html={html} />
          </div>
          {THEME.FRAGMENTS.comments.enabled && (
            <button
              type="button"
              data-fragment-comments
              data-fragment-term={fragmentTerm(entry.data.id)}
              aria-haspopup="dialog"
              aria-controls="fragment-comments-dialog"
            >
              {labels.comments}
            </button>
          )}
        </article>
      ))
    }
    {
      total > 1 && (
        <CyberPagination
          model={paginationModel}
          locale={locale}
          blogRoot={feedHref}
          pathname={Astro.url.pathname}
          labels={{
            previous: messages.blog.previous,
            next: messages.blog.next,
            paginationAria: messages.blog.paginationAria,
            jumpTo: messages.blog.jumpTo || 'Jump to page',
            jumpInputLabel: messages.blog.jumpInputLabel || 'Page number',
            jumpGo: messages.blog.jumpGo || 'Go',
          }}
          config={{
            jump: {
              enabled: THEME.PAGINATION.JUMP.ENABLED,
              enterToGo: THEME.PAGINATION.JUMP.ENTER_TO_GO,
            },
            style: {
              enabled: THEME.PAGINATION.STYLE.ENABLED,
              mode: THEME.PAGINATION.STYLE.MODE,
              variants: THEME.PAGINATION.STYLE.VARIANTS,
              fixedVariant: THEME.PAGINATION.STYLE.FIXED_VARIANT,
            },
          }}
        />
      )
    }
  </section>
  {THEME.FRAGMENTS.comments.enabled && <FragmentComments locale={locale} labels={labels} />}
  <BackToTop slot="body-end" label={messages.blog.backToTop} layout="feed" />
</CyberShell>
<script>
  import { initFragmentLinks } from '../../../scripts/fragment-links.js';
  import { initFragmentsChrome } from '../../../scripts/fragments-chrome.js';
  initFragmentsChrome();
  initFragmentLinks();
  document.addEventListener('astro:page-load', initFragmentsChrome);
  document.addEventListener('astro:page-load', initFragmentLinks);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) {
      initFragmentsChrome();
      initFragmentLinks();
    }
  });
</script>
<style is:global>
  /* Route-only neutral presentation; other Cyber pages keep their effects. */
  body.cyber-page:has([data-fragments]) .cyber-spotlight,
  body.cyber-page:has([data-fragments]) [data-cyber-layer] {
    display: none;
  }
  body.cyber-page:has([data-fragments]) {
    --chrome-active: #b5bdc8;
    --chrome-link-hover: #e5e9ef;
    --chrome-bg: rgba(7, 11, 18, 0.38);

    main {
      padding-top: calc(var(--fragments-nav-height, 80px) + 1rem);
    }

    .fragments-space {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-color: #020305;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
    header {
      background: var(--chrome-bg);
      border-bottom-color: rgba(151, 165, 186, 0.18);
    }
    footer {
      position: relative;
      z-index: 5;
      background: var(--chrome-bg);
      border-top-color: rgba(151, 165, 186, 0.18);
    }

    .fragments-feed .fragment-card {
      border: 16px solid transparent;
      border-image: url('../../../assets/theme/frames/fragment-temple-frame.svg') 32 stretch;
      background: transparent;
      background-clip: padding-box;
      clip-path: none;
      box-shadow: inset 0 0 0 1px rgba(87, 82, 113, 0.25);
      animation: none;
    }
    .fragments-feed .fragment-card::before {
      content: '';
      display: block;
      position: absolute;
      top: -21px;
      left: calc(50% - 5px);
      bottom: auto;
      right: auto;
      width: 10px;
      height: 22px;
      background: linear-gradient(105deg, #17152c 10%, #655582 45%, #302444 50%, #19172e 85%);
      clip-path: polygon(48% 0, 82% 22%, 100% 72%, 50% 100%, 0 76%, 22% 26%);
      pointer-events: none;
      filter: none;
    }
    .fragments-feed .fragment-card::after {
      content: '';
      display: block;
      position: absolute;
      inset: 8px -11px;
      width: auto;
      height: auto;
      background:
        url('../../../assets/theme/frames/fragment-temple-glyphs.svg') left center / 7px 28px
          no-repeat,
        url('../../../assets/theme/frames/fragment-temple-glyphs.svg') right center / 7px 28px
          no-repeat;
      pointer-events: none;
      filter: none;
    }
    .fragments-feed [data-fragment-comments]::before,
    .fragments-feed [data-fragment-comments]::after,
    .pagination .pg-item::before {
      display: none;
    }
    .fragments-feed .fragment-date,
    .fragments-feed .fragment-copy {
      color: #94a3b2;
      text-shadow: 0 1px 0 #05080d;
    }
    .fragments-feed .fragment-date {
      font-family: 'Consolas', 'Liberation Mono', 'Courier New', monospace;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.025em;
      text-transform: uppercase;
    }
    .fragments-feed .fragment-date:is(:hover, :focus-visible),
    .fragments-feed .fragment-copy:is(:hover, :focus-visible) {
      color: #ffe39a;
      text-shadow: 0 1px 0 #05080d;
    }
    .fragments-feed .fragment-card :is(h2, h3) {
      color: #cdd3d9;
      font-family: 'Verdana', 'Geneva', 'Atkinson', sans-serif;
      font-weight: 700;
      letter-spacing: 0.035em;
      line-height: 1.45;
      text-shadow:
        0 -1px 0 #d4e0ea26,
        0 1px 0 #454f5c,
        0 2px 0 #05080e;
    }
    .fragments-feed .fragment-card h2 {
      margin-top: 0.2rem;
      padding-bottom: 0.4rem;
      background: linear-gradient(90deg, #b39b56 0 1.2rem, #35404d 1.2rem, transparent) left
        bottom / min(14rem, 65%) 1px no-repeat;
    }
    .fragments-feed .fragment-body a {
      color: #c5d3e3;
      text-shadow: none;
    }
    .fragments-feed [data-fragment-comments] {
      color: #d8cba6;
      border: 2px solid;
      border-color: #90775a #4b3540 #382832 #70513e;
      border-radius: 9px 6px 10px 5px;
      background:
        radial-gradient(ellipse at 20% 0%, #98765340, transparent 55%),
        linear-gradient(160deg, #302331, #1b151f);
      clip-path: none;
      box-shadow:
        inset 0 0 0 1px #b49a6d33,
        inset 0 1px 1px #ae8d5a22,
        inset 0 -2px 2px #100b14;
      text-shadow: 0 1px 1px #09060b;
      animation: none;
    }
    .fragments-feed [data-fragment-comments]:is(:hover, :focus-visible) {
      color: #f0dfad;
      border-color: #b29a73 #705063 #50384a #96724f;
      background:
        radial-gradient(ellipse at 20% 0%, #ab89534d, transparent 55%),
        linear-gradient(160deg, #3b2b3b, #241a29);
      box-shadow:
        inset 0 0 0 1px #cfb17c44,
        inset 0 1px 1px #ae8d5a33,
        inset 0 -2px 2px #100b14;
    }
    .fragments-feed [data-fragment-comments]:focus-visible {
      outline: 2px solid #d8cba6;
      outline-offset: 3px;
    }
    .pagination .pg-item,
    .pagination-jump-btn {
      position: relative;
      box-sizing: border-box;
      min-width: 52px;
      min-height: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      padding-block: 0;
      border: 2px solid;
      border-color: #414b4f #0c1318 #04070b #242b2e;
      border-radius: 1px;
      background:
        radial-gradient(ellipse at 0% 100%, #9b593311, transparent 65%),
        radial-gradient(ellipse at 28% 0%, #ffffff30, #ffffff0b 32%, transparent 64%) center top /
          100% 36% no-repeat,
        var(--bc-face, linear-gradient(#070b0f, #020406 40%, #000102 65%, #030609));
      color: #d7d9d4;
      font-family: 'Verdana', 'Geneva', 'Atkinson', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      line-height: 1;
      font-variant-numeric: lining-nums tabular-nums;
      letter-spacing: 0.025em;
      text-shadow: 0 1px 0 #020409;
      box-shadow:
        inset 0 0 0 1px #05080d,
        inset 0 0 0 3px #1b2224,
        inset 0 0 0 4px #060a10,
        0 1px 0 #020407;
      clip-path: none;
      animation: none;
      transform: none;
    }
    .pagination .pg-item:not(.current):not(.pg-ellipsis) {
      --bc-face: linear-gradient(#0f1215, #06090c 45%, #010203);
      box-shadow:
        inset 0 0 0 1px #070a0c,
        inset 0 0 0 3px #1f2728,
        inset 0 1px 1px 3px #cdd4cd1f,
        inset 0 -2px 3px 3px #000c,
        0 1px 0 #020407;
    }
    .pagination .pg-item:is(:hover, :focus-visible),
    .pagination-jump-btn:is(:hover, :focus-visible) {
      color: #e1e9e8;
      border-color: #637075 #233238 #101a20 #3d484d;
      box-shadow:
        inset 0 0 0 1px #070d15,
        inset 0 0 0 3px #29363c,
        inset 0 0 0 4px #070c14,
        0 1px 0 #020407;
      transform: none;
    }
    .pagination .pg-item.current {
      --bc-face: linear-gradient(#000102, #030609);
      color: #bfeaff;
      box-shadow:
        inset 0 0 0 1px #04080e,
        inset 0 0 0 3px #1b2224,
        inset 0 0 0 4px #04070c,
        inset 0 0 9px 5px #000e,
        0 1px 0 #020407;
    }
    .pagination .pg-item.current::after {
      content: '';
      position: absolute;
      inset: 4px;
      border: 2px solid;
      border-color: #010203 #222829 #444b49 #080b0c;
      box-shadow:
        0 0 0 1px #010203,
        inset 0 0 0 1px #0f1215;
      pointer-events: none;
    }
    .pagination .pg-item.pg-ellipsis {
      min-width: 0;
      width: 1.2rem;
      padding-inline: 0.15rem;
      border: 0;
      border-color: transparent;
      background: transparent;
      box-shadow: none;
      color: #9cbbc6;
      font-family: 'Consolas', 'Liberation Mono', monospace;
      letter-spacing: 0.12em;
      text-shadow: none;
      font-size: 0;
      opacity: 1;
    }
    .pagination .pg-item.pg-ellipsis::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: currentColor;
      box-shadow:
        -6px 0 currentColor,
        6px 0 currentColor;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }
    .pagination-jump {
      border-color: #28323d;
      border-radius: 2px;
      background: #0c1118d9;
    }
    .pagination-jump-label {
      color: #9eaab5;
    }
    .pagination-jump-input {
      color: #d3dbe1;
      border-color: #2e3c4a;
      border-radius: 2px;
      background: #070c12;
      font-variant-numeric: tabular-nums;
    }
    .pagination .pg-item:focus-visible,
    .pagination-jump-btn:focus-visible,
    .pagination-jump-input:focus {
      outline: 2px solid #b2dfea;
      outline-offset: 2px;
      box-shadow: none;
    }
    .ai-back-to-top {
      color: #d8cba6;
      border: 3px solid;
      border-color: #90775a #4b3540 #382832 #70513e;
      border-radius: 42% 36% 43% 34%;
      background:
        radial-gradient(ellipse at 22% 15%, #98765355, transparent 38%),
        radial-gradient(ellipse at 80% 85%, #5a354c55, transparent 45%),
        radial-gradient(ellipse, #302331, #1b151f 72%);
      box-shadow:
        inset 0 0 0 1px #b49a6d44,
        inset 2px 2px 3px #ae8d5a22,
        inset -2px -3px 3px #100b14,
        0 3px 8px #0008;
      text-shadow: 0 1px 1px #09060b;
      backdrop-filter: none;
    }
    .ai-back-to-top:is(:hover, :focus-visible) {
      color: #f0dfad;
      border-color: #b29a73 #705063 #50384a #96724f;
      box-shadow:
        inset 0 0 0 1px #cfb17c66,
        inset 2px 2px 3px #ae8d5a33,
        inset -2px -3px 3px #100b14,
        0 3px 8px #0008;
    }
    .ai-back-to-top:focus-visible {
      outline: 2px solid #d8cba6;
      outline-offset: 4px;
    }
    footer {
      box-shadow: none;
    }
    /* Brood War atmosphere: alloy, organic shadow and psionic light share one instrument. */
    .music-deck {
      --music-accent: #a5c5d6;
      --music-accent-alt: #8c829f;
      --music-text: #d4d1c7;
      --music-muted: #a19b99;
      --music-border: #48434b;
      --music-border-strong: #b3def2;
      --music-surface: #0c0b15;
      --music-glow: transparent;
      border: 3px solid;
      border-color: #7c7461 #302c38 #1c1821 #5b493a;
      border-radius: 4px 2px 5px 2px;
      background:
        radial-gradient(ellipse at 90% 12%, #58637314, transparent 48%),
        radial-gradient(ellipse at 5% 95%, #63434d1c, transparent 58%),
        radial-gradient(ellipse at 0% 0%, #8b806715, transparent 42%),
        linear-gradient(145deg, #15141a99, #07090ca3 55%, #160e189e);
      box-shadow:
        inset 0 0 0 1px #020309,
        inset 0 0 0 3px #303247,
        inset 0 0 0 4px #0a0911,
        inset 0 8px 16px #0007,
        0 1px 0 #b7b4a238,
        0 10px 28px #000b;
      backdrop-filter: none;
    }
    .music-deck::before {
      display: block;
      background:
        radial-gradient(ellipse at 35% -20%, #d5d4c612, transparent 62%),
        radial-gradient(ellipse at 20% 100%, #7b56600c, transparent 48%);
      background-size: auto;
      mix-blend-mode: normal;
      opacity: 1;
    }
    .music-deck .music-deck__topbar {
      padding: 0.55rem 0.65rem 0.2rem;
    }
    .music-deck .music-deck__header {
      padding: 0 0.65rem 0.4rem;
    }
    .music-deck .music-deck__body {
      gap: 0.6rem;
      padding: 0 0.65rem 0.65rem;
    }
    .music-deck .music-deck__controls,
    .music-deck .music-deck__footer {
      gap: 0.45rem;
    }
    .music-deck[data-collapsed='true'] .music-deck__topbar {
      padding: 0.4rem 0.65rem 0.1rem;
    }
    .music-deck[data-collapsed='true'] .music-deck__header {
      padding: 0 0.65rem 0.2rem;
    }
    .music-deck[data-collapsed='true'] .music-deck__body {
      gap: 0.3rem;
      padding: 0 0.65rem 0.55rem;
    }
    .music-deck .music-deck__chrome {
      gap: 0.35rem;
    }
    .music-deck :is(.music-deck__led, .music-deck__led--alt) {
      width: 4px;
      height: 7px;
      border-radius: 1px;
      background: #c3dce5;
      box-shadow:
        inset 0 0 0 1px #e1f4ff33,
        0 0 4px #7fa8c54d;
      animation: none;
    }
    .music-deck .music-deck__led--alt {
      height: 5px;
      background: #b29a6d;
      box-shadow: 0 0 3px #a78a5633;
    }
    .music-deck
      :is(
        .music-deck__collapse,
        .music-deck__btn,
        .music-deck__playlist-toggle,
        .music-deck__track-chip
      ) {
      border: 1px solid;
      border-color: #605b4e #343039 #29232d #50443c;
      border-radius: 2px;
      background:
        radial-gradient(ellipse at 50% 0%, #cbb88a0c, transparent 75%),
        linear-gradient(#1b191b, #111015);
      box-shadow:
        inset 0 1px 0 #c5c0cd0b,
        inset 0 -1px 0 #0004;
      color: #cfcbbe;
      font-family: 'Verdana', 'Geneva', sans-serif;
      text-shadow: 0 1px 1px #000;
      transform: none;
    }
    .music-deck
      :is(
        .music-deck__collapse,
        .music-deck__btn,
