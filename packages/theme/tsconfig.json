{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@anglefeint/site-config": ["src/project/config/index.ts"],
      "@anglefeint/site-config/*": ["src/project/config/*"],
      "@anglefeint/site-i18n": ["src/project/i18n/config.ts"],
      "@anglefeint/site-i18n/*": ["src/project/i18n/*"],
      "@anglefeint/theme-default-i18n": ["src/i18n/messages.ts"]
    }
  }
}
