---
import type { GetStaticPaths } from 'astro';
import { terminalDocumentId } from '@anglefeint/astro-theme/utils/terminal-document';
import TerminalBackdrop from '@anglefeint/astro-theme/components/shared/TerminalBackdrop.astro';
import WindowShell from '@anglefeint/astro-theme/components/shared/WindowShell.astro';
import DecoderWorkbench from '@anglefeint/astro-theme/components/decoder/DecoderWorkbench.astro';
import HackerShell from '@anglefeint/astro-theme/layouts/shells/HackerShell.astro';
import { getCollection } from 'astro:content';
import { getAboutConfig } from '../../config/about';
import { THEME } from '../../config/theme';
import {
  DEFAULT_LOCALE,
  ENABLED_LOCALES,
  type Locale,
  blogIdToSlugAnyLocale,
  isLocale,
  localePath,
} from '../../i18n/config';
import { getMessages } from '../../i18n/messages';
import { postsForLocale } from '../../i18n/posts';

export const getStaticPaths = (async () =>
  THEME.ABOUT_PAGE_ENABLED
    ? ENABLED_LOCALES.map((lang) => ({
        params: { lang },
      }))
    : []) satisfies GetStaticPaths;

const langParam = Astro.params.lang ?? DEFAULT_LOCALE;
const locale: Locale = isLocale(langParam) ? langParam : DEFAULT_LOCALE;
const messages = getMessages(locale);
const ABOUT_CONFIG = getAboutConfig(locale);

const pageTitle = messages.about.title;
const pageDescription = messages.about.description;
const allPosts = await getCollection('blog');
const blogPosts = postsForLocale(allPosts, locale).map((p) => ({
  slug: blogIdToSlugAnyLocale(p.id),
  title: p.data.title ?? p.id,
  documentUrl: `${localePath(locale, '/terminal/')}${terminalDocumentId(p.id)}.json`,
}));

const escapeHtml = (value: string): string =>
  value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');

const aiBody = `<pre>${ABOUT_CONFIG.modals.ai.lines.map(escapeHtml).join('\n')}</pre>`;
const decoder = messages.decoder;

const aboutRuntimeConfig = {
  effects: ABOUT_CONFIG.effects,
  terminal: {
    labels: messages.terminal,
    cwd: ABOUT_CONFIG.scriptsPath,
    entries: [
      {
        path: `${ABOUT_CONFIG.scriptsPath}/about.md`,
        type: 'file',
        title: messages.about.title,
        content: [
          ABOUT_CONFIG.sections.who,
          ABOUT_CONFIG.sections.what,
          ...ABOUT_CONFIG.sections.ethos,
          ABOUT_CONFIG.sections.now,
          ABOUT_CONFIG.sections.signature,
        ].join('\n\n'),
      },
      ...blogPosts.map((post) => ({
        path: `${ABOUT_CONFIG.scriptsPath}/${post.slug}.md`,
        type: 'file',
        title: post.title,
        url: post.documentUrl,
      })),
    ],
  },
  keyboard: ABOUT_CONFIG.modals.help,
  decoderLabels: decoder,
  scriptFolderLabels: messages.scriptFolders,
  modalContent: {
    'dl-data': {
      title: ABOUT_CONFIG.modals.dlData.title,
      body: `<div class="hacker-modal-download"><div class="modal-subtitle">${escapeHtml(ABOUT_CONFIG.modals.dlData.subtitle)}</div><div class="hacker-modal-progress" id="dl-progress"></div></div>`,
      type: 'progress',
    },
    ai: {
      title: ABOUT_CONFIG.modals.ai.title,
      body: aiBody,
      type: 'plain',
    },
    decryptor: {
      title: ABOUT_CONFIG.modals.decryptor.title,
      body: '',
      type: 'decryptor',
    },
    help: {
      title: ABOUT_CONFIG.modals.help.title,
      body: '',
      type: 'keyboard',
    },
    'all-scripts': {
      title: ABOUT_CONFIG.modals.allScripts.title,
      body: '',
      type: 'scripts',
    },
  },
};
---

<HackerShell
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  bodyClass="hacker-page about-page"
>
  <Fragment slot="body-start">
    <template id="hacker-decoder-tpl"
      ><DecoderWorkbench labels={decoder} pageLabels={messages.decoderPage} /></template
    >
    <TerminalBackdrop
      class="hacker-bg"
      canvasClass="hacker-bg-canvas"
      inputLabel={messages.terminal.commandInput}
    />
    <div class="hacker-progress" aria-hidden="true"></div>
    <button
      type="button"
      class="hacker-back-to-top"
      aria-label={ABOUT_CONFIG.labels.backToTop}
      title={ABOUT_CONFIG.labels.backToTop}>↑</button
    >
    <div class="hacker-toast" aria-live="polite" aria-atomic="true"></div>
    <div class="hacker-mouse-glow" aria-hidden="true"></div>
    <nav class="hacker-sidebar" aria-label={ABOUT_CONFIG.labels.quickAccess}>
      <button
        type="button"
        class="hacker-folder"
        data-modal="dl-data"
        aria-label={ABOUT_CONFIG.sidebar.dlData}
      >
        <svg
          class="hacker-folder-icon"
          viewBox="0 0 24 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M12 2v10m-4-4 4 4 4-4M4 13v5h16v-5"></path>
        </svg>
        <span>{ABOUT_CONFIG.sidebar.dlData}</span>
      </button>
      <button
        type="button"
        class="hacker-folder"
        data-modal="ai"
        aria-label={ABOUT_CONFIG.sidebar.ai}
      >
        <svg
          class="hacker-folder-icon"
          viewBox="0 0 24 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="m5 5 5 5-5 5m8 0h6M2 2h20v16H2z"></path>
        </svg>
        <span>{ABOUT_CONFIG.sidebar.ai}</span>
      </button>
      <button
        type="button"
        class="hacker-folder"
        data-modal="decryptor"
        aria-label={ABOUT_CONFIG.sidebar.decryptor}
      >
        <svg
          class="hacker-folder-icon"
          viewBox="0 0 24 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="m8 3-6 7 6 7m8-14 6 7-6 7m-3-15-2 16"></path>
        </svg>
        <span>{ABOUT_CONFIG.sidebar.decryptor}</span>
      </button>
      <button
        type="button"
        class="hacker-folder"
        data-modal="help"
        aria-label={ABOUT_CONFIG.sidebar.help}
      >
        <svg
          class="hacker-folder-icon"
          viewBox="0 0 24 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M9 6a3 3 0 0 1 6 0c0 3-3 2-3 5m0 3v1"></path><circle cx="12" cy="10" r="9"
          ></circle>
        </svg>
        <span>{ABOUT_CONFIG.sidebar.help}</span>
      </button>
      <button
        type="button"
        class="hacker-folder"
        data-modal="all-scripts"
        aria-label={ABOUT_CONFIG.sidebar.allScripts}
      >
        <svg
          class="hacker-folder-icon"
          viewBox="0 0 24 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M4 3h12l4 4v12H4zM15 3v5h5M7 11h10M7 15h7"></path>
        </svg>
        <span>{ABOUT_CONFIG.sidebar.allScripts}</span>
      </button>
      <button
        type="button"
        class="hacker-folder"
        data-oracle
        aria-label="Oracle"
        aria-haspopup="dialog"
      >
        <svg
          class="hacker-folder-icon"
          viewBox="0 0 24 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M7 18V2h10v16M4 18h16M10 10h1"></path>
        </svg>
        <span>Oracle</span>
      </button>
    </nav>
    <template id="hacker-scripts-folders-tpl">
      <div class="hacker-modal-scripts">
        <div class="hacker-modal-scripts-path">{ABOUT_CONFIG.scriptsPath}</div>
        <div class="hacker-modal-scripts-grid">
          {
            blogPosts.map((post) => (
              <div class="hacker-script-card">
                <a href={localePath(locale, `/blog/${post.slug}`)} class="hacker-script-folder">
                  <svg
                    class="hacker-script-folder-icon"
                    viewBox="0 0 24 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="M2 4h8l2 2h10v12H2V4z" />
                  </svg>
                  <span class="hacker-script-folder-label" title={post.title}>
                    {post.title}
                  </span>
                </a>
                <button
                  type="button"
                  class="hacker-script-copy"
                  data-copy-script-title
                  title={messages.scriptFolders.copyTitle}
                  aria-label={messages.scriptFolders.copyTitle}
                >
                  <svg
                    viewBox="0 0 20 20"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                  >
                    <rect x="7" y="7" width="10" height="10" rx="1" />
                    <path d="M12 5V3H3v9h2" />
                  </svg>
                </button>
              </div>
            ))
          }
        </div>
        <p class="hacker-script-copy-status" role="status" aria-live="polite"></p>
      </div>
    </template>
    <WindowShell
      title={ABOUT_CONFIG.labels.modalOutput}
      closeLabel={ABOUT_CONFIG.labels.modalClose}
      controls={messages.windowControls}
    >
      {
        THEME.DECODER_PAGE_ENABLED && (
          <a
            slot="actions"
            class="decoder-full-link"
            data-decoder-entry
            hidden
            href={localePath(locale, '/decoder/')}
          >
            {messages.decoderPage.fullTool} <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </WindowShell>
  </Fragment>
  <div class="hacker-load-scan" aria-hidden="true"></div>
  <article class="about-shell">
    <div class="prose">
      <div class="title about-title">
        {ABOUT_CONFIG.metaLine && <div class="hacker-meta">{ABOUT_CONFIG.metaLine}</div>}
        <h1>{messages.about.title}</h1>
        <hr />
        <div class="hacker-title-bar" aria-hidden="true"></div>
      </div>

      <div class="hacker-response">
        <div class="hacker-response-header">
          <div class="hacker-window-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span class="hacker-response-label">{ABOUT_CONFIG.labels.responseOutput}</span>
        </div>
        <div class="hacker-body">
          <h2 class="about-section-title">01 / {messages.about.who}</h2>
          <p>{ABOUT_CONFIG.sections.who}</p>

          <h2 class="about-section-title">02 / {messages.about.what}</h2>
          <p>{ABOUT_CONFIG.sections.what}</p>

          <h2 class="about-section-title">03 / {messages.about.ethos}</h2>
          <div class="about-manifest">
            <ul>
              {ABOUT_CONFIG.sections.ethos.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <h2 class="about-section-title">04 / {messages.about.now}</h2>
          <p>{ABOUT_CONFIG.sections.now}</p>

          <h2 class="about-section-title">05 / {messages.about.contact}</h2>
          <p>
            {ABOUT_CONFIG.sections.contactLead}
            {
              ABOUT_CONFIG.contact.email.trim() && (
                <>
                  {ABOUT_CONFIG.labels.contactEmailLead}
                  <a href={`mailto:${ABOUT_CONFIG.contact.email}`}>
                    {ABOUT_CONFIG.labels.contactEmailLabel}
                  </a>
                </>
              )
            }
            {ABOUT_CONFIG.labels.contactConnectLead}
            <a href={ABOUT_CONFIG.contact.githubUrl} target="_blank" rel="noopener noreferrer"
              >{ABOUT_CONFIG.contact.githubLabel}</a
            >.
          </p>

          <blockquote class="about-signature">{ABOUT_CONFIG.sections.signature}</blockquote>
          <span class="hacker-cursor" aria-hidden="true"></span>
        </div>
      </div>
      <button
        type="button"
        class="hacker-regenerate"
        aria-label={messages.about.regenerate}
        title={messages.about.regenerate}>{messages.about.regenerate}</button
      >
    </div>
  </article>
  <Fragment slot="body-end">
    <script
      is:inline
      id="hacker-runtime-config"
      type="application/json"
      set:html={JSON.stringify(aboutRuntimeConfig).replace(/</g, '\\u003c')}
    />
    <script>
      import { initAboutEffects } from '@anglefeint/astro-theme/scripts/about-effects.js';
      const runtimeConfigEl = document.getElementById('hacker-runtime-config');
      const runtimeConfigText = runtimeConfigEl?.textContent?.trim() ?? '';
      if (!runtimeConfigText) {
        throw new Error('Missing hacker runtime config payload.');
      }
      let runtimeConfig;
      try {
        runtimeConfig = JSON.parse(runtimeConfigText);
      } catch (_error) {
        throw new Error('Invalid hacker runtime config JSON payload.');
      }
      const decoderLabels = runtimeConfig?.decoderLabels;
      const modalContent = runtimeConfig?.modalContent;
      const aiModalBody = modalContent?.ai?.body;
      const hasRequiredModalKeys =
        modalContent &&
        typeof modalContent === 'object' &&
        ['dl-data', 'ai', 'decryptor', 'help', 'all-scripts'].every((key) => modalContent[key]);
      if (
        !decoderLabels ||
        typeof decoderLabels.decode !== 'string' ||
        !hasRequiredModalKeys ||
        typeof aiModalBody !== 'string' ||
        aiModalBody.trim().length === 0
      ) {
        throw new Error('Hacker runtime config missing valid modal content.');
      }
      initAboutEffects();
    </script>
  </Fragment>
</HackerShell>
